{
    "version": 3,
    "configurePresets": [
        {
            "name": "host",
            "displayName": "Host unit tests (host C compiler from CC or PATH)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/host",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host",
            "configurePreset": "host"
        }
    ],
    "testPresets": [
        {
            "name": "host",
            "configurePreset": "host",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
